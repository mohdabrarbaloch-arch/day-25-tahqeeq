# ─────────────────────────────────────────────────────────────
# Tahqeeq — environment template
# Copy to .env and fill in. Never commit the real .env.
# ─────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────
# "development" or "production". In production the app refuses to
# boot with the default SECRET_KEY below.
APP_ENV=development

# Signing key for JWTs. Generate a real one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-key-change-me-before-deploying-please

# JWT lifetime in minutes. 60 * 24 * 7 = one week.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Database ─────────────────────────────────────────────────
# SQLite for local dev (no server needed):
DATABASE_URL=sqlite:///./tahqeeq.db
# PostgreSQL for production (docker-compose sets this for you):
# DATABASE_URL=postgresql+psycopg://tahqeeq:tahqeeq@db:5432/tahqeeq

# Echo SQL to stdout. Useful when debugging, noisy otherwise.
SQL_ECHO=false

# ── Security ─────────────────────────────────────────────────
# bcrypt work factor. 12 is a good default; raise it if you can
# afford the login latency.
BCRYPT_ROUNDS=12

# Comma-separated allowed origins. "*" is fine for local dev only.
CORS_ORIGINS=*

# Requests per window, per client IP, per endpoint group.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ── URL ingestion ────────────────────────────────────────────
# Master switch. Set false to disable outbound fetching entirely
# (recommended if you deploy somewhere you don't control egress).
ALLOW_URL_FETCH=true

# Hard ceiling on a fetched page, in bytes. Anything larger is
# truncated rather than buffered.
URL_FETCH_MAX_BYTES=2000000

# Per-request timeout in seconds.
URL_FETCH_TIMEOUT_SECONDS=10

# Maximum redirects to follow before giving up.
URL_FETCH_MAX_REDIRECTS=3

# ── Analysis limits ──────────────────────────────────────────
# Longest text accepted, in characters. ~40k chars is a long
# feature article.
MAX_TEXT_CHARS=40000

# Shortest text accepted. Below this there is nothing to judge.
MIN_TEXT_CHARS=80

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# Set true to expose /docs and /redoc. Automatically forced off
# when APP_ENV=production.
ENABLE_DOCS=true
